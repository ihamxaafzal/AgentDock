# Copy to .env, replace placeholders, and keep .env private.
PORT=4317

# Configure the Hermes profiles you created. Use one coordinator profile and
# one or more workers. Give each profile its own API_SERVER_KEY.
HERMES_AGENTS='[{"id":"coordinator","name":"Your Coordinator","profile":"your-coordinator-profile","url":"http://127.0.0.1:8642/p/your-coordinator-profile","key":"COORDINATOR_PROFILE_KEY","nativeCoordinator":true},{"id":"worker-one","name":"Your Agent","profile":"your-worker-profile","url":"http://127.0.0.1:8642/p/your-worker-profile","key":"WORKER_PROFILE_KEY","reportsTo":"coordinator","capabilities":["topic-research"]}]'

# Native Hermes coordination requires paths from your Hermes installation.
# HERMES_HOME=C:/Users/YOUR_NAME/AppData/Local/hermes
# HERMES_SOURCE_DIR=C:/path/to/hermes-agent
# HERMES_NATIVE_PYTHON=C:/path/to/hermes-python/python.exe
# HERMES_EXTRACTION_DIR=C:/Users/YOUR_NAME/AppData/Local/hermes/shared/agentdock-extractions

# Optional override for local mission records, uploaded copies, and logs.
# AETHER_DATA_DIR=C:/Users/YOUR_NAME/AppData/Local/AgentDock/data

# Initial limit for independent missions (the Room Settings UI supports 1–256).
AETHER_CONCURRENT_MISSIONS=5

# Optional Google Flow image generation settings.
# AETHER_IMAGE_OUTPUT_DIR=C:/Users/YOUR_NAME/Pictures/AgentDock
# AETHER_FLOW_CHROME_PROFILE=Default
# AETHER_FLOW_CHROME_EXECUTABLE=C:/Program Files/Google/Chrome/Application/chrome.exe
